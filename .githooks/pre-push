#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
sh scripts/quality.sh --require-qlty
checked=false
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  case "$remote_sha" in
    0000000000000000000000000000000000000000)
      branch=${remote_ref#refs/heads/}
      remote_tracking="refs/remotes/$1/$branch"
      if git rev-parse --verify --quiet "$remote_tracking" >/dev/null; then
        base=$(git merge-base "$local_sha" "$remote_tracking")
        range="$base..$local_sha"
      else
        range="$local_sha^!"
      fi
      ;;
    *) range="$remote_sha..$local_sha" ;;
  esac
  sh scripts/lint-commits.sh "$range"
  checked=true
done
if [ "$checked" = false ]; then sh scripts/lint-commits.sh HEAD; fi
